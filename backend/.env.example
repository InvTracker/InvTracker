# Server Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS) - Comma-separated whitelist
CORS_ORIGINS=https://invtracker-henna.vercel.app,http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=invtracker-9a207
# Option A: Path to service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option B: Client Email & Private Key directly from environment
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Role Permission Allowlist (Comma-separated)
ADMIN_EMAILS=admin@example.com,admin@campus.edu
KITCHEN_EMAILS=kitchen@example.com,kitchen@campus.edu

# Redis Distributed Locks & Concurrency Mutex (Optional - falls back to in-memory mutex)
REDIS_URL=redis://localhost:6379
